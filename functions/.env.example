# Copy this file to "functions/.env.local":   copy functions\.env.example functions\.env.local
# Without it, the Functions emulator stops at an interactive prompt for GEMINI_MODEL.
# functions/.env.local is gitignored. Never commit real keys or passwords.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- AI (all optional, all free) ----------
# Without any AI, every feature still works with built-in rule-based logic.
#
# Option 1: free Gemini key from https://aistudio.google.com/apikey (local emulator only)
GEMINI_API_KEY_LOCAL=
#
# Option 2: Ollama, a free AI that runs on this computer (no key, no account): https://ollama.com
#   install it, then run:  ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# ---------- Email (optional, free with Gmail) ----------
# Without these, emails are only recorded in the admin "AI Inbox" as "simulated".
# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_USER=
SMTP_PASS=

# Department and admin addresses. Defaults are demo addresses (@campusfix.demo).
# ADMIN_EMAIL=admin@college.edu
# DEPT_EMAIL_IT=it@college.edu
# DEPT_EMAIL_ELECTRICAL=electrical@college.edu
# DEPT_EMAIL_PLUMBING=plumbing@college.edu
# DEPT_EMAIL_SANITATION=sanitation@college.edu
# DEPT_EMAIL_SECURITY=security@college.edu
# DEPT_EMAIL_MESS=mess@college.edu
# DEPT_EMAIL_ESTATE=estate@college.edu

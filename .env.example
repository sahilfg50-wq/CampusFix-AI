# Copy this file to ".env.local":   copy .env.example .env.local
#
# The values below work as-is with the local Firebase Emulators
# (firebase emulators:start --project demo-campusfix). No real Firebase project is needed.
#
# For a real Firebase project: set VITE_USE_FIREBASE_EMULATORS=false and replace the values with
# the config from Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# These are Firebase *web* settings (not secret). Security comes from Firestore rules.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-campusfix.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-campusfix
VITE_FIREBASE_STORAGE_BUCKET=demo-campusfix.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
# Region where the Cloud Functions are deployed (must match functions/index.js)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# true = connect to the local emulators (Auth 9099, Firestore 8080, Functions 5001)
VITE_USE_FIREBASE_EMULATORS=true

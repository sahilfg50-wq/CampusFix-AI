# Copy this file to ".env.local" and replace each value with the config from
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# These are Firebase *web* settings (not secret). Security comes from Firestore rules.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Region where the Cloud Function is deployed (must match functions/index.js)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
